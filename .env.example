# Example .env for pgcdc
# Copy this to .env and replace values, or mount a production .env at runtime.

# Database (use secret/store for real value)
DATABASE_URL="postgres://pgcdc:change_me@postgres:5432/dbname?sslmode=disable"

# NSQ / publisher settings
NSQ_ADDR="nsq:4150"

# Other settings
LOG_LEVEL="info"

